modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SMTP_HOST = "smtp.maileroo.com"
SMTP_PORT = "587"
INBOUND_EMAIL_ORG_ID = "3"
INBOUND_EMAIL_DOMAIN = "taskdesk.uk"

[userenv.production]
STAGING_PROTECTION = "1"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18115
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 18150
externalPort = 3001

[[ports]]
localPort = 25627
externalPort = 3000
