modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 18115
externalPort = 4200

[[ports]]
localPort = 18116
externalPort = 5000

[[ports]]
localPort = 18150
externalPort = 3001

[[ports]]
localPort = 25627
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SEED_SECRET = "TaskDeskSeed2024!"
SMTP_HOST = "smtp.maileroo.com"
SMTP_PORT = "587"
INBOUND_EMAIL_TOKEN = "53cad3d0890cf594ae90ab618faed81e798c7939e1af056e"
INBOUND_EMAIL_ORG_ID = "3"
