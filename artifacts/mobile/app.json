{
  "expo": {
    "name": "TaskDesk",
    "slug": "taskdesk",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/taskdesk-app-icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taskdesk.mobile"
    },
    "android": {
      "package": "com.taskdesk.mobile",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/taskdesk-adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/taskdesk-favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskDesk accede alle foto solo per impostare la tua immagine profilo. / TaskDesk accesses photos only to set your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TaskDesk uses location only while the app is open to show your area on the dashboard. Coordinates are not saved. / TaskDesk usa la posizione solo con l’app aperta per mostrare la zona nella dashboard. Le coordinate non vengono salvate."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/taskdesk-app-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/taskdesk-app-icon.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0f62fe",
          "sounds": [],
          "mode": "production",
          "androidMode": "default",
          "androidCollapsedTitle": "TaskDesk"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/mobile"
    },
    "extra": {
      "eas": {
        "projectId": "8956445a-0008-48e3-8d0e-d0e044e89dba"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8956445a-0008-48e3-8d0e-d0e044e89dba",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
