diff --git a/lib/check-depth.js b/lib/check-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..678767481a7b92c927f37ee6f1538d129b929be8
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Bound all AST walkers, including callers that supply an AST directly.
+const MAX_DEPTH = 128;
+
+const checkDepth = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  while (stack.length > 0) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError('Brace pattern exceeds maximum nesting depth');
+    }
+    if (node && node.nodes) {
+      for (const child of node.nodes) {
+        stack.push({ node: child, depth: depth + 1 });
+      }
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, checkDepth };
